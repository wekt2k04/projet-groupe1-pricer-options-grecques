<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Portefeuille de dérivés (tableau de bord) ===== -->
    <record id="view_cours_portfolio_tree" model="ir.ui.view">
        <field name="name">cours.portfolio.tree</field>
        <field name="model">cours.portfolio</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="total_value"/>
                <field name="total_payoff"/>
                <field name="nb_calls"/>
                <field name="nb_puts"/>
                <field name="pct_calls"/>
            </tree>
        </field>
    </record>
    <record id="view_cours_portfolio_form" model="ir.ui.view">
        <field name="name">cours.portfolio.form</field>
        <field name="model">cours.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/></group>
                    <group string="Tableau de bord">
                        <group>
                            <field name="total_value"/>
                            <field name="total_forward_value"/>
                            <field name="total_option_profit"/>
                            <field name="total_payoff"/>
                        </group>
                        <group>
                            <field name="nb_calls"/>
                            <field name="nb_puts"/>
                            <field name="pct_calls"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Forwards">
                            <field name="forward_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="S0"/>
                                    <field name="r"/>
                                    <field name="T"/>
                                    <field name="F0"/>
                                    <field name="St"/>
                                    <field name="t"/>
                                    <field name="Vt"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Options">
                            <field name="option_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="position"/>
                                    <field name="quantity"/>
                                    <field name="K"/>
                                    <field name="S_T"/>
                                    <field name="premium"/>
                                    <field name="payoff"/>
                                    <field name="profit"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cours_portfolio_graph" model="ir.ui.view">
        <field name="name">cours.portfolio.graph</field>
        <field name="model">cours.portfolio</field>
        <field name="arch" type="xml">
            <graph string="Valeur des portefeuilles" type="bar">
                <field name="name"/>
                <field name="total_value" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_cours_portfolio" model="ir.actions.act_window">
        <field name="name">Portefeuilles de dérivés</field>
        <field name="res_model">cours.portfolio</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <!-- ===== Markowitz ===== -->
    <record id="view_cours_markowitz_tree" model="ir.ui.view">
        <field name="name">cours.markowitz.tree</field>
        <field name="model">cours.markowitz</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="rho"/>
                <field name="w_A"/>
                <field name="mu_p"/>
                <field name="sigma_p"/>
                <field name="sigma_avg"/>
                <field name="w_min"/>
            </tree>
        </field>
    </record>
    <record id="view_cours_markowitz_form" model="ir.ui.view">
        <field name="name">cours.markowitz.form</field>
        <field name="model">cours.markowitz</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/></group>
                    <group>
                        <group string="Actif A">
                            <field name="mu_A"/>
                            <field name="sigma_A"/>
                        </group>
                        <group string="Actif B">
                            <field name="mu_B"/>
                            <field name="sigma_B"/>
                        </group>
                    </group>
                    <group>
                        <group string="Portefeuille">
                            <field name="rho"/>
                            <field name="w_A"/>
                            <field name="mu_p"/>
                            <field name="variance_p"/>
                            <field name="sigma_p"/>
                            <field name="sigma_avg"/>
                            <field name="diversification_gain"/>
                        </group>
                        <group string="Variance minimale">
                            <field name="w_min"/>
                            <field name="sigma_min"/>
                            <field name="mu_min"/>
                            <field name="short_needed"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cours_markowitz" model="ir.actions.act_window">
        <field name="name">Portefeuilles Markowitz</field>
        <field name="res_model">cours.markowitz</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== CAPM ===== -->
    <record id="view_cours_capm_tree" model="ir.ui.view">
        <field name="name">cours.capm.tree</field>
        <field name="model">cours.capm</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="beta"/>
                <field name="expected"/>
                <field name="observed"/>
                <field name="alpha"/>
                <field name="verdict"/>
            </tree>
        </field>
    </record>
    <record id="view_cours_capm_form" model="ir.ui.view">
        <field name="name">cours.capm.form</field>
        <field name="model">cours.capm</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_estimate_beta" type="object" string="Estimer β = Cov / Var"/>
                </header>
                <sheet>
                    <group><field name="name"/></group>
                    <group>
                        <group string="Paramètres">
                            <field name="rf"/>
                            <field name="rm"/>
                            <field name="beta"/>
                            <field name="cov_im"/>
                            <field name="var_m"/>
                        </group>
                        <group string="Résultat">
                            <field name="expected"/>
                            <field name="observed"/>
                            <field name="alpha"/>
                            <field name="verdict"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cours_capm" model="ir.actions.act_window">
        <field name="name">CAPM</field>
        <field name="res_model">cours.capm</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== Volatilité ===== -->
    <record id="view_cours_volatility_tree" model="ir.ui.view">
        <field name="name">cours.volatility.tree</field>
        <field name="model">cours.volatility</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="nb_returns"/>
                <field name="vol_hist"/>
                <field name="vol_ewma"/>
                <field name="vol_annual"/>
                <field name="vol_ml"/>
            </tree>
        </field>
    </record>
    <record id="view_cours_volatility_form" model="ir.ui.view">
        <field name="name">cours.volatility.form</field>
        <field name="model">cours.volatility</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_predict_ml" type="object" string="Prévoir (scikit-learn)"/>
                </header>
                <sheet>
                    <group><field name="name"/><field name="ewma_lambda"/></group>
                    <group string="Données"><field name="prices" nolabel="1"/></group>
                    <group string="Résultats">
                        <field name="nb_returns"/>
                        <field name="vol_hist"/>
                        <field name="vol_ewma"/>
                        <field name="vol_annual"/>
                        <field name="vol_ml"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cours_volatility" model="ir.actions.act_window">
        <field name="name">Volatilité</field>
        <field name="res_model">cours.volatility</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
