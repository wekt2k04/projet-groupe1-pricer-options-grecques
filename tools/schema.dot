digraph G {
  rankdir=LR; nodesep=0.6; ranksep=1.1; bgcolor="white";
  fontname="DejaVu Sans";
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444"];
  labelloc="t"; labeljust="l"; fontsize=14;
  label=<<b>Schéma de base de données — Groupe 1 · Pricer d'Options &amp; Grecques (version S1)</b>>;

  option [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#0B3C5D" align="left"><font color="white"><b>cours.option</b>  (TP 0, étendu par _inherit)</font></td></tr>
      <tr><td align="left" bgcolor="#EEEEEE"><b>Existant (TP 0)</b><br align="left"/>name · type (ou option_type) · S_T · K · premium<br align="left"/>payoff · profit<br align="left"/></td></tr>
      <tr><td align="left" bgcolor="#FFF3D6"><b>Ajouté par le groupe 1 (entrées)</b><br align="left"/>ticker · spot · strike · maturite (années)<br align="left"/>taux (continu) · volatilite (annualisée)<br align="left"/></td></tr>
      <tr><td align="left" bgcolor="#E3F4EA"><b>Ajouté (calculés, stockés)</b><br align="left"/>prix_bs · greeks_delta · greeks_gamma<br align="left"/>greeks_vega · greeks_theta · greeks_rho<br align="left"/>prix_bs_hist · prix_bs_lstm<br align="left"/></td></tr>
      <tr><td align="left" bgcolor="#F7E6F0"><b>Ajouté (IA)</b><br align="left"/>prediction_id → cours.vol.prediction<br align="left"/>boutons : Calculer · Prédire la volatilité<br align="left"/></td></tr>
    </table>>];

  serie [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#009E73" align="left"><font color="white"><b>cours.vol.serie</b>  (nouveau, optionnel)</font></td></tr>
      <tr><td align="left">ticker · date · close<br align="left"/>rendement (log) · vol_realisee_5j<br align="left"/></td></tr>
    </table>>];

  pred [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#CC79A7" align="left"><font color="white"><b>cours.vol.prediction</b>  (nouveau)</font></td></tr>
      <tr><td align="left">ticker · date_prevision · horizon_jours<br align="left"/>vol_predite · modele (LSTM / EWMA / GARCH)<br align="left"/>rmse_test · qlike_test<br align="left"/></td></tr>
    </table>>];

  hors [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#999999">
      <tr><td align="left" bgcolor="#F4F4F4"><font color="#777777"><b>Non étendus</b><br align="left"/>cours.forward · cours.portfolio<br align="left"/>(TP 0, hors périmètre du groupe 1)<br align="left"/></font></td></tr>
    </table>>];

  option -> pred  [label="Many2one\nprediction_id", arrowhead=normal];
  serie -> pred   [label="même ticker\n(entrée du LSTM)", style=dashed];
  serie -> option [label="même ticker\n(σ historique)", style=dashed];
  {rank=same; option; hors}
}
