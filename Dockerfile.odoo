# Image Odoo du groupe 1 : odoo:17.0 + numpy, pour que le module importe src/pricing.py
# (SciPy reste optionnel : pricing.py se replie sur math.erf).
FROM odoo:17.0
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-numpy \
    && rm -rf /var/lib/apt/lists/*
USER odoo
